{
  "manifest_version": 3,
  "name": "Freebuff Focus Mode",
  "short_name": "FB Focus",
  "version": "1.8.2",
  "description": "Quiet focus sessions for freebuff.com. Ads on by default, hidden only while you focus.",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "*://freebuff.com/*",
    "*://*.freebuff.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-picking": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Hide an element on freebuff.com"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Freebuff Focus Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://freebuff.com/*",
        "*://*.freebuff.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "focus_rules",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  }
}
